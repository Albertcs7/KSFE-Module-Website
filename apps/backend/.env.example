PORT=5000
NODE_ENV=development
JWT_SECRET=replace-this-with-a-secret
REFRESH_TOKEN_SECRET=replace-this-with-a-refresh-secret
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:5174
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=password
DB_NAME=db name
EXTERNAL_AUTH_API_URL= the api
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_MS=60000

# PDF/report rendering
PDF_USE_FRONTEND=false
FRONTEND_PREVIEW_BASE_URL=http://localhost:5173
PDF_AUTH_TOKEN=
PDF_MAX_CONCURRENCY=2